@{
    ViewData["Title"] = "Dashboard";
}

<div class="container py-4">

    <div class="mb-4">
        <h1>Business Intelligence Dashboard</h1>
        <p class="lead">
            Explore Nordic Delights Oy's Power BI reports.
        </p>
    </div>

    <hr />

    <div class="report-card">
        <h2>Sales Performance</h2>
        <p>Sales analysis based on the Northwind database.</p>

        <div class="ratio ratio-16x9 mb-5">
            <iframe title="NordicDelights_SalesPerformance" 
                width="1140" 
                height="541.25" 
                src="https://app.powerbi.com/reportEmbed?reportId=2574d98f-f0cf-4990-a81b-dc8102ec3012&autoAuth=true&ctid=0992c7f7-c210-47c4-909e-f112d9f907a0" 
                frameborder="0" 
                allowFullScreen="true">
            </iframe>
        </div>
    </div>

    <hr />

    <div class="report-card">
        <h2>Market Overview</h2>
        <p>Financial and geographical market overview.</p>

        <div class="ratio ratio-16x9 mb-5">
            <iframe title="NordicDelights_MarketOverview" 
                width="1140" height="541.25" 
                src="https://app.powerbi.com/reportEmbed?reportId=1b1b97f4-7f27-4a8c-9a99-6f2a6c906d52&autoAuth=true&ctid=0992c7f7-c210-47c4-909e-f112d9f907a0" 
                frameborder="0" 
                allowFullScreen="true">
            </iframe>
        </div>
    </div>

    <hr />

    <div class="report-card">
        <h2>European Market Potential</h2>
        <p>European population data for market analysis.</p>

        <div class="ratio ratio-16x9 mb-5">
            <iframe title="NordicDelights_EuropeanMarketPotential" 
                    width="1140" height="541.25" 
                    src="https://app.powerbi.com/reportEmbed?reportId=7212cbd1-15ac-43d3-a48b-a1ce9a65f2ab&autoAuth=true&ctid=0992c7f7-c210-47c4-909e-f112d9f907a0" 
                    frameborder="0" 
                    allowFullScreen="true"></iframe>
        </div>
    </div>

    <hr />

    <div class="report-card">
        <h2>Customer &amp; Product Sales</h2>
        <p>Sales analysis based on fictional Nordic Delights sales data.</p>

        <div class="ratio ratio-16x9 mb-5">
            <iframe title="NordicDelights_CustomerProductSales" 
                    width="1140" height="541.25" 
                    src="https://app.powerbi.com/reportEmbed?reportId=6f032f22-2602-48ee-97fa-2bc95592ecf9&autoAuth=true&ctid=0992c7f7-c210-47c4-909e-f112d9f907a0" 
                    frameborder="0" 
                    allowFullScreen="true">
            </iframe>
        </div>
    </div>

</div>
